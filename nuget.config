<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Where Cmms.Infrastructure comes from (lnicoara/cmms#3026). cmms publishes itself to GitHub Packages,
       one version per commit on main, and this repo pins to the commit a target environment runs.

       No credential is stored here, deliberately. GitHub Packages requires auth even to read, so a
       credential in a checked-in file is a credential in git history. Supply it out of band instead:

         CI          the workflow's built-in GITHUB_TOKEN
         a laptop    a PAT with read:packages, added once with
                       dotnet nuget update source github -u <you> -p <PAT> --store-password-in-clear-text
                     or exported as NUGET_AUTH_TOKEN and consumed by the setup-dotnet action
         the image   passed to `az acr build` as a secret build arg, never as a build arg, so it does not
                     land in the layer history of a published image

       clear/ before add/ so a machine with a stray global nuget.config cannot silently resolve
       Cmms.Infrastructure from somewhere else. There is exactly one place these packages come from. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/lnicoara/index.json" />
  </packageSources>

  <!-- The Cmms.* packages resolve ONLY from github, and everything else ONLY from nuget.org. Without this
       a restore asks every source for every package, so a public package named Cmms.Infrastructure
       appearing on nuget.org could answer first. That is the substitution attack package source mapping
       exists for, and the load tooling writes directly to a production-shaped database. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Cmms.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
