<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Where Cmms.Infrastructure comes from (lnicoara/cmms#3026): a LOCAL FOLDER, packed out of a cmms
       checkout rather than fetched from a hosted feed.

       The generator needs the product's real EF model, and the loader's image cannot reach outside its
       own build context, so the model has to arrive as a package. A hosted feed would have been the
       obvious answer and costs a credential that then has to cross into a remote `az acr build` without
       landing in the image. This costs nothing: scripts/pre-prod/load-pre-prod.sh packs the pinned commit
       into .packages/ seconds before the image is built, and the same folder serves a local build.

       It also cannot go stale, which is why this is better here rather than merely cheaper. A feed holds
       whatever was pushed to it; this folder holds what your checkout produced moments ago, and the script
       refuses to pack a checkout that is not at the pinned commit.

       The tradeoff, stated because it is real: a clone of this repository on a machine with no cmms
       checkout does not build. Run scripts/pre-prod/load-pre-prod.sh, or pack by hand:
         dotnet pack <cmms>/src/Cmms.Infrastructure -c Release -p:Version=1.0.0-g<pin> -o .packages

       clear/ before add/ so a machine with a stray global nuget.config cannot silently resolve
       Cmms.Infrastructure from somewhere else. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value=".packages" />
  </packageSources>

  <!-- Cmms.* resolves ONLY from the local folder, everything else ONLY from nuget.org. Without this a
       restore asks every source for every package, so a public package named Cmms.Infrastructure could
       answer first. That is the substitution this mapping exists to prevent, and the tooling it protects
       writes directly into a production-shaped database. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="Cmms.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
