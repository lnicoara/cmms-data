<Project Sdk="Microsoft.NET.Sdk">

  <!-- lnicoara/cmms#2876, per epic #2731: offline synthetic-data generator for the pre-prod load test.
       Writes gzipped JSON Lines to a local directory. Opens NO database connection and reads no Azure
       configuration, which is what lets it run and be validated on a laptop with only the .NET SDK.
       Loading the artifact is a separate concern and is deliberately not here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cmms.LoadDataGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cmms.Infrastructure\Cmms.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
