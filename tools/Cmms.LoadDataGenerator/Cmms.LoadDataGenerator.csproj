<Project Sdk="Microsoft.NET.Sdk">

  <!-- lnicoara/cmms#2876, per epic #2731: offline synthetic-data generator for the pre-prod load test.
       Writes gzipped JSON Lines to a local directory. Opens NO database connection and reads no Azure
       configuration, which is what lets it run and be validated on a laptop with only the .NET SDK.
       Loading the artifact is a separate concern and is deliberately not here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cmms.LoadDataGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <!-- The product's real EF model, as a PACKAGE pinned to one commit (lnicoara/cmms#3026).
       This was a ProjectReference to ../../src/Cmms.Infrastructure when the tooling lived in cmms.

       Not a source copy, and the distinction is load-bearing. ModelBridge builds a real CmmsDbContext over
       a never-opened connection for two separate reasons: the column manifest is derived from the live
       model rather than hand-listed, AND the resulting EntityEntry lets audit rows run through the
       product's own AuditDiff and AuditEventFactory instead of a second implementation that would drift.
       A forked copy would agree with itself and disagree with the target database, and that surfaces as a
       corrupt bulk load rather than as a build error.

       $(CmmsVersion) lives in Directory.Build.props. Change it there, never here, and read the reasoning
       above it before changing it at all. -->
  <ItemGroup>
    <PackageReference Include="Cmms.Infrastructure" Version="$(CmmsVersion)" />
  </ItemGroup>

  <!-- The profiles are in profiles/, one copy, and this repo's rule 2 says they are the authoritative
       input because generation is a pure function of the profile. They used to exist twice, here and
       there, byte-identical, with the generator reading the copy nobody called authoritative. Linked
       rather than duplicated so that cannot happen again. -->
  <ItemGroup>
    <None Include="..\..\profiles\*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
