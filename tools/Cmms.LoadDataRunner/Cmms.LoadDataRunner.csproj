<Project Sdk="Microsoft.NET.Sdk">

  <!-- lnicoara/cmms#2908, per epic #2731: bulk-copies the offline artifact from #2876 into ONE provisioned
       tenant database. Deliberately narrow (grill round 1): it holds no DDL permission and mutates no schema.
       Index drop/rebuild and constraint re-trust live in an operator script, not here.

       The ProjectReference on the generator is not incidental. Reusing ModelBridge means the column manifest
       the loader writes against is the SAME derivation the generator wrote with, so the two cannot drift
       (grill round 5). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cmms.LoadDataRunner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cmms.Infrastructure\Cmms.Infrastructure.csproj" />
    <ProjectReference Include="..\Cmms.LoadDataGenerator\Cmms.LoadDataGenerator.csproj" />
  </ItemGroup>

</Project>
