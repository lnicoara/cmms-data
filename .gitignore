# .NET build output, in case anyone tries to build the reference snapshot in tools/
bin/
obj/

# Generator output, scratch or otherwise. No dataset is committed: generation is a pure function of the
# profile, so `profiles/` plus a `cmms` checkout reproduces `data/` byte for byte, and carrying 3.7 GB of
# recoverable bytes in history would make every future clone pay for every past regeneration.
artifact/
artifact-*/
data/
.packages/
